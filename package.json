{
  "name": "twigx",
  "description": "A new CLI generated with oclif",
  "keywords": [
    "oclif"
  ],
  "version": "0.0.0",
  "author": "Raju Bepary",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "twigx": "./bin/run.js"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "format": "prettier --write .",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run format && npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "oclif": {
    "bin": "twigx",
    "dirname": "twigx",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " "
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "chalk": "^6.0.0",
    "execa": "^10.0.1",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "prettier": "^3.9.6",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "repository": "https://github.com/rajubeparybd/twigx",
  "homepage": "https://github.com/rajubeparybd/twigx",
  "bugs": "https://github.com/rajubeparybd/twigx/issues"
}
